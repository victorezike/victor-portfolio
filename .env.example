# Copy this file to .env.local and fill in real values.
# .env / .env.local are git-ignored — never commit real secrets.

# =========================================
# DATABASE (MongoDB Atlas)
# =========================================
# Atlas → your cluster → Connect → Drivers → copy the connection string.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<your-cluster>.mongodb.net/?retryWrites=true&w=majority&appName=victor-portfolio
# Database name (created automatically on first write)
MONGODB_DB=victor_portfolio

# Secret used to read /api/subscribers (send as the `x-admin-key` header)
ADMIN_API_KEY=change-me-to-a-long-random-string

# =========================================
# NOTIFICATION SETTINGS
# =========================================
ENABLE_EMAIL_ALERTS=true
ENABLE_TELEGRAM_ALERTS=false
ENABLE_DISCORD_ALERTS=false
ENABLE_SLACK_ALERTS=false

# =========================================
# EMAIL (Gmail SMTP)
# =========================================
EMAIL_SERVICE=gmail
EMAIL_USER=ezikevictor11@gmail.com
# Must be a 16-character Gmail App Password, NOT your Google account password:
# https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=kkfr dtfv vnrj oqgp
ALERT_EMAIL=ezikevictor11@gmail.com
